# Environment
.env
.env.local
.env.*.local

# Build artifacts
output/
repodata/
build/
*.rpm
*.src.rpm

# GPG keys (never commit these!)
*.key
secrets/
private.gpg
private.key

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# Mock build results (but not configs)
mock/*/
mock/repo/
result/
local-repo/

# Source tarballs — download at build time via spectool
src/**/*.tar.gz
src/**/*.tar.xz
src/**/*.tar.bz2
src/**/*.tgz
src/**/*.zip

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Gap-measurement repodata cache (scripts/measure-hummingbird-gap.py)
.cache/

# Dist-git import state written by the build workflow
hummingbird-imports.json

# Cloudflare Wrangler local cache (never commit account auth)
.wrangler/

# Node dependencies for workers/ (repo-proxy Worker test suite)
workers/node_modules/

# Cloudflare Worker local build output
/dist/

site/

# Snapshotted from the live repo at deploy time by
# scripts/snapshot-repo-contents.py -- megabytes that change daily and are
# never read from git. The Pages build regenerates it; see .github/workflows/pages.yml.
docs/repo-contents.json

# Coverage output. .coveragerc sets parallel = True, so a local run leaves one
# .coverage.<host>.<pid>.<random> per process alongside the combined file.
.coverage
.coverage.*
coverage-python.xml
htmlcov/
