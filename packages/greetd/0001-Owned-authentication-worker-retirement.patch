+#[cfg(test)]
+mod retirement_tests {
+    use super::*;
+    use std::os::unix::io::{AsRawFd, FromRawFd, OwnedFd};
+
+    struct BlockedWorker {
+        worker: Arc<Worker>,
+        release: Option<OwnedFd>,
+    }
+    impl BlockedWorker {
+        fn spawn() -> Self {
+            let mut descriptors = [-1; 2];
+            assert_eq!(
+                unsafe { libc::pipe2(descriptors.as_mut_ptr(), libc::O_CLOEXEC) },
+                0
+            );
+            let read = unsafe { OwnedFd::from_raw_fd(descriptors[0]) };
+            let write = unsafe { OwnedFd::from_raw_fd(descriptors[1]) };
+            let worker = match unsafe { Worker::clone_owned() }.expect("required native clone3") {
+                crate::retirement::Spawn::Child => unsafe {
+                    libc::close(write.as_raw_fd());
+                    let mut byte = 0_u8;
+                    libc::read(read.as_raw_fd(), (&mut byte as *mut u8).cast(), 1);
+                    libc::_exit(0);
+                },
+                crate::retirement::Spawn::Parent(worker) => worker,
+            };
+            Self {
+                worker,
+                release: Some(write),
+            }
+        }
+        fn retire(&mut self) {
+            self.release.take();
+            let mut status = 0;
+            loop {
+                let observed = unsafe { libc::waitpid(self.worker.pid(), &mut status, 0) };
+                if observed < 0
+                    && std::io::Error::last_os_error().raw_os_error() == Some(libc::EINTR)
+                {
+                    continue;
+                }
+                assert_eq!(observed, self.worker.pid());
+                assert!(libc::WIFEXITED(status));
+                self.worker.observe_reaped(observed).unwrap();
+                break;
+            }
+        }
+    }
+    impl Drop for BlockedWorker {
+        fn drop(&mut self) {
+            if !self.worker.reaped() {
+                self.retire();
+            }
+        }
+    }
