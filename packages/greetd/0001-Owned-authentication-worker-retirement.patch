+    pub fn connection(&self, stream: &tokio::net::UnixStream) -> Result<Arc<Connection>, Error> {
+        let id = self.next_connection.get();
+        let next = id.checked_add(1).ok_or("connection identity exhausted")?;
+        let connection = Connection::new(id)?;
+        use std::os::unix::io::{AsRawFd, FromRawFd};
+        let descriptor = unsafe { libc::fcntl(stream.as_raw_fd(), libc::F_DUPFD_CLOEXEC, 0) };
+        if descriptor < 0 {
+            return Err(std::io::Error::last_os_error().into());
+        }
+        let held = unsafe { std::os::unix::net::UnixStream::from_raw_fd(descriptor) };
+        // Custody needs no reactor registration: this duplicate is never read
+        // or written and remains CLOEXEC across the worker's exec.
+        self.clients
+            .borrow_mut()
+            .insert(id, (connection.clone(), held));
+        self.next_connection.set(next);
+        Ok(connection)
+    }
