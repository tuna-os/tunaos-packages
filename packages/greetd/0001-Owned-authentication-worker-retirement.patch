+
+    // Native-only production clone/pidfd/reap control. Unsupported kernel or
+    // seccomp is a failure, never a skip or a PID-only qualification fallback.
+    #[test]
+    fn atomic_worker_identity_requires_its_terminal_reap() {
+        let mut pipe = [-1; 2];
+        assert_eq!(
+            unsafe { libc::pipe2(pipe.as_mut_ptr(), libc::O_CLOEXEC) },
+            0
+        );
+        let read = unsafe { OwnedFd::from_raw_fd(pipe[0]) };
+        let write = unsafe { OwnedFd::from_raw_fd(pipe[1]) };
+        let worker = match unsafe { Worker::clone_owned() }.expect("required native clone3") {
+            Spawn::Child => unsafe {
+                libc::close(write.as_raw_fd());
+                let mut byte = 0_u8;
+                libc::read(read.as_raw_fd(), (&mut byte as *mut u8).cast(), 1);
+                libc::_exit(0);
+            },
+            Spawn::Parent(worker) => worker,
+        };
+        assert!(!worker.reaped());
+        assert!(worker.observe_reaped(worker.pid() + 1).is_err());
+        assert!(worker.observe_reaped(worker.pid()).is_err());
+        drop(write);
+        let mut status = 0;
+        let observed = loop {
+            let result = unsafe { libc::waitpid(worker.pid(), &mut status, 0) };
+            if result < 0 && io::Error::last_os_error().raw_os_error() == Some(libc::EINTR) {
+                continue;
+            }
+            break result;
+        };
+        assert_eq!(observed, worker.pid());
+        assert!(libc::WIFEXITED(status));
+        worker.observe_reaped(observed).unwrap();
+        assert!(worker.reaped());
+        worker.signal(libc::SIGKILL).unwrap(); // no rediscovered numeric PID
+    }
