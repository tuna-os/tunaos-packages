+//! Linux-owned authentication worker and connection cancellation identities.
+//! No remote child-exit claim is inferred from an IPC acknowledgement.
+use std::io;
+use std::os::unix::io::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+use std::time::Duration;
+use tokio::sync::Notify;
+
+#[repr(C)]
+#[derive(Default)]
+struct CloneArgs {
+    flags: u64,
+    pidfd: u64,
+    child_tid: u64,
+    parent_tid: u64,
+    exit_signal: u64,
+    stack: u64,
+    stack_size: u64,
+    tls: u64,
+    set_tid: u64,
+    set_tid_size: u64,
+    cgroup: u64,
+}
+pub enum Spawn {
+    Child,
+    Parent(Arc<Worker>),
+}
+pub struct Worker {
+    pid: i32,
+    pidfd: OwnedFd,
+    reaped: AtomicBool,
+    changed: Notify,
+}
+impl Worker {
+    /// Called on the existing single-thread daemon creator, with all child
+    /// exec resources prepared first. No fallback can lose post-spawn custody.
+    pub unsafe fn clone_owned() -> io::Result<Spawn> {
+        let mut descriptor: i32 = -1;
+        let args = CloneArgs {
+            flags: libc::CLONE_PIDFD as u64,
+            pidfd: (&mut descriptor as *mut i32) as u64,
+            exit_signal: libc::SIGCHLD as u64,
+            ..CloneArgs::default()
+        };
+        let result = libc::syscall(libc::SYS_clone3, &args, std::mem::size_of::<CloneArgs>());
+        if result < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if result == 0 {
+            return Ok(Spawn::Child);
+        }
+        // clone3's success contract returns the descriptor atomically with PID.
+        // Kernel contract violation is fatal; never publish unknown ownership.
+        if descriptor < 0 || result > i32::MAX as libc::c_long {
+            libc::abort();
+        }
+        Ok(Spawn::Parent(Arc::new(Self {
+            pid: result as i32,
+            pidfd: OwnedFd::from_raw_fd(descriptor),
+            reaped: AtomicBool::new(false),
+            changed: Notify::new(),
+        })))
+    }
+    pub fn pid(&self) -> i32 {
+        self.pid
+    }
+    /// ONLY central waitpid Exited/Signaled calls this, before any await.
+    pub fn observe_reaped(&self, pid: i32) -> io::Result<()> {
+        if pid != self.pid {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        let mut poll = libc::pollfd {
+            fd: self.pidfd.as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        let ready = unsafe { libc::poll(&mut poll, 1, 0) };
+        if ready != 1
+            || poll.revents & (libc::POLLIN | libc::POLLHUP) == 0
+            || poll.revents & libc::POLLNVAL != 0
+        {
+            return Err(io::ErrorKind::PermissionDenied.into());
+        }
+        self.reaped.store(true, Ordering::Release);
+        self.changed.notify_waiters();
+        Ok(())
+    }
+    pub fn reaped(&self) -> bool {
+        self.reaped.load(Ordering::Acquire)
+    }
+    pub async fn wait_for_reap(&self, budget: Duration) -> bool {
+        let deadline = tokio::time::Instant::now() + budget;
+        loop {
+            let wake = self.changed.notified();
+            tokio::pin!(wake);
+            wake.as_mut().enable();
+            if self.reaped() {
+                return true;
+            }
+            if tokio::time::timeout_at(deadline, wake).await.is_err() {
+                return self.reaped();
+            }
+        }
+    }
+    pub async fn reaped_wait(&self) {
+        loop {
+            let wake = self.changed.notified();
+            tokio::pin!(wake);
+            wake.as_mut().enable();
+            if self.reaped() {
+                return;
+            }
+            wake.await;
+        }
+    }
+    /// Lost Session custody still retains exact registered kernel ownership.
+    /// Signals never count as completion: ONLY central waitpid can retire it.
+    pub async fn cancel_unknown(&self) -> io::Result<()> {
+        for signal in [libc::SIGTERM, libc::SIGKILL] {
+            if let Err(error) = self.signal(signal) {
+                if error.raw_os_error() != Some(libc::ESRCH) {
+                    return Err(error);
+                }
+            }
+            if self.wait_for_reap(Duration::from_secs(1)).await {
+                return Ok(());
+            }
+        }
+        Err(io::ErrorKind::TimedOut.into())
+    }
+    /// Signals ONLY this held kernel identity, never a rediscovered numeric PID.
+    pub fn signal(&self, signal: i32) -> io::Result<()> {
+        if self.reaped() {
+            return Ok(());
+        }
+        let result = unsafe {
+            libc::syscall(
+                libc::SYS_pidfd_send_signal,
+                self.pidfd.as_raw_fd(),
+                signal,
+                std::ptr::null::<libc::siginfo_t>(),
+                0,
+            )
+        };
+        if result == 0 {
+            Ok(())
+        } else {
+            Err(io::Error::last_os_error())
+        }
+    }
+}
+
+pub struct Connection {
+    pub id: u64,
+    canceled: AtomicBool,
+    wake: Notify,
+}
+impl Connection {
+    pub fn new(id: u64) -> io::Result<Arc<Self>> {
+        if id == 0 || id == u64::MAX {
+            return Err(io::ErrorKind::InvalidInput.into());
+        }
+        Ok(Arc::new(Self {
+            id,
+            canceled: AtomicBool::new(false),
+            wake: Notify::new(),
+        }))
+    }
+    pub fn cancel(&self) {
+        self.canceled.store(true, Ordering::Release);
+        self.wake.notify_waiters();
+    }
+    pub fn canceled(&self) -> bool {
+        self.canceled.load(Ordering::Acquire)
+    }
+    pub async fn canceled_wait(&self) {
+        loop {
+            let wake = self.wake.notified();
+            tokio::pin!(wake);
+            wake.as_mut().enable();
+            if self.canceled() {
+                return;
+            }
+            wake.await;
+        }
+    }
+}
+/// Independent RDHUP readiness, not readable buffered input. Local Tokio only:
+/// no watcher thread may exist before the daemon's next clone/exec.
+pub struct PeerLoss {
+    readiness: tokio::io::unix::AsyncFd<OwnedFd>,
+}
+impl PeerLoss {
+    pub fn new(socket: RawFd) -> io::Result<Self> {
+        let fd = unsafe { libc::epoll_create1(libc::EPOLL_CLOEXEC) };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let owned = unsafe { OwnedFd::from_raw_fd(fd) };
+        let mut event = libc::epoll_event {
+            events: (libc::EPOLLRDHUP | libc::EPOLLHUP | libc::EPOLLERR) as u32,
+            u64: 1,
+        };
+        if unsafe { libc::epoll_ctl(fd, libc::EPOLL_CTL_ADD, socket, &mut event) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self {
+            readiness: tokio::io::unix::AsyncFd::new(owned)?,
+        })
+    }
+    pub async fn wait(&self) -> io::Result<()> {
+        loop {
+            let mut ready = self.readiness.readable().await?;
+            match ready.try_io(|fd| {
+                let mut event: libc::epoll_event = unsafe { std::mem::zeroed() };
+                let count = unsafe { libc::epoll_wait(fd.as_raw_fd(), &mut event, 1, 0) };
+                if count > 0 {
+                    Ok(())
+                } else if count == 0 {
+                    Err(io::ErrorKind::WouldBlock.into())
+                } else {
+                    Err(io::Error::last_os_error())
+                }
+            }) {
+                Ok(result) => return result,
+                Err(_) => continue,
+            }
+        }
+    }
+}
