+async fn client_handler(ctx: &Rc<Context>, mut stream: UnixStream) -> Result<(), Error> {
+    use std::os::unix::io::AsRawFd;
+    let owner = ctx.connection(&stream)?;
+    // Separate local cleanup custody outlives an aborted/panicking protocol
+    // future. Context's retained socket cannot be dropped by that future.
+    let cleanup_context = ctx.clone();
+    let cleanup_owner = owner.clone();
+    task::spawn_local(async move {
+        cleanup_owner.canceled_wait().await;
+        if let Err(error) = cleanup_context.cancel_owned(&cleanup_owner).await {
+            eprintln!("authentication cleanup retained: {}", error);
+        }
+        cleanup_context.retain_until_reaped(&cleanup_owner).await;
+    });
+    let guard = ClientGuard {
+        context: ctx,
+        owner: owner.clone(),
+    };
+    let loss = crate::retirement::PeerLoss::new(stream.as_raw_fd())?;
+    let result = tokio::select! {
+        result = client_protocol(ctx, &mut stream, &owner) => result,
+        observed = loss.wait() => { owner.cancel(); observed.map_err(Error::from) },
+        _ = owner.canceled_wait() => Ok(()),
+    };
+    // Dropping the selected protocol future releases any get_question lock.
+    owner.cancel();
+    let retirement = ctx.cancel_owned(&owner).await;
+    ctx.close_retired_connection(&owner);
+    drop(guard);
+    retirement?;
+    result
 }
 
