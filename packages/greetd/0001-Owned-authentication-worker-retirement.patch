+        let context = context();
+        let mut child = BlockedWorker::spawn();
+        context
+            .workers
+            .borrow_mut()
+            .insert(child.worker.pid(), (child.worker.clone(), Some(7)));
+        let fresh = Connection::new(8).unwrap();
+        assert!(context.cancel_barrier(&fresh).await.is_err());
+        assert!(!child.worker.reaped());
+        assert!(!fresh.canceled());
+        assert!(context.owned_auth_workers_remain());
