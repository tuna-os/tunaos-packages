+impl Drop for Context {
+    fn drop(&mut self) {
+        // LocalSet teardown cannot turn an unconfirmed worker into a receipt.
+        // Deliberately retain its socket descriptor until process death. The
+        // client must still require a fresh positive barrier from the SAME
+        // admitted daemon, so death-generated EOF never settles retirement.
+        for (id, (_, socket)) in std::mem::take(self.clients.get_mut()) {
+            if self
+                .workers
+                .get_mut()
+                .values()
+                .any(|(worker, owner)| *owner == Some(id) && !worker.reaped())
+            {
+                use std::os::unix::io::IntoRawFd;
+                let _ = socket.into_raw_fd();
+            }
+        }
+    }
+}
