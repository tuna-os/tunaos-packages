+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Native password feedback for the tuna-shell-gtk AT-SPI application."""
+
+from orca import presentation_manager, typing_echo_presenter
+from orca.ax_utilities import AXUtilities
+from orca.ax_utilities_event import AXUtilitiesEvent, TextEventReason
+from orca.scripts.toolkits.gtk import script as gtk
+
+
+class Script(gtk.Script):
+    """Present committed password insertions without observing private keys."""
+
+    def __init__(self, app):
+        super().__init__(app)
+        self._password_caret = None
+
+    @staticmethod
+    def _is_focused_password(event):
+        return (
+            AXUtilities.is_password_text(event.source)
+            and AXUtilities.is_editable(event.source)
+            and AXUtilities.is_focused(event.source)
+        )
+
+    @staticmethod
+    def _is_valid_delta(event):
+        # GtkEntryBuffer bounds each committed offset/count to u16.
+        return 0 <= event.detail1 <= 65535 and 0 < event.detail2 <= 65535
+
+    def _remember_password_caret(self, event, target):
+        # The native queue preserves password carets in delta order. Only
+        # the next caret may consume this cause; live state can already
+        # reflect later queued edits and must not replace event metadata.
+        reason = (
+            TextEventReason.SYSTEM_UPDATE
+            if event.type.endswith("system")
+            else TextEventReason.TYPING
+        )
+        self._password_caret = (event.source, target, reason)
+
+    def _on_text_inserted(self, event):
+        self._password_caret = None
+        if not self._is_focused_password(event):
+            return super()._on_text_inserted(event)
+
+        # Retain native, password-safe braille work even when speech is
+        # disabled or this is a system update. Never read event.any_data
+        # or query credential text for custom speech.
+        self.update_braille(event.source)
+        if not self._is_valid_delta(event):
+            return True
+        self._remember_password_caret(event, event.detail1 + event.detail2)
+        if (
+            event.type.endswith("system")
+            or not typing_echo_presenter.get_presenter().get_key_echo_enabled()
+        ):
+            return True
+
+        # Own this native delta once; stale private-key history cannot
+        # cause a second character, word or sentence echo.
+        presenter = presentation_manager.get_manager()
+        for _ in range(event.detail2):
+            presenter.speak_character("●")
+        return True
+
+    def _on_text_deleted(self, event):
+        self._password_caret = None
+        if not self._is_focused_password(event):
+            return super()._on_text_deleted(event)
+
+        self.update_braille(event.source)
+        if self._is_valid_delta(event):
+            self._remember_password_caret(event, event.detail1)
+        # Deletion is not insertion feedback, regardless of stale keys.
+        return True
+
+    def _on_caret_moved(self, event):
+        pending = self._password_caret
+        self._password_caret = None
+        if (
+            pending is not None
+            and self._is_focused_password(event)
+            and pending[:2] == (event.source, event.detail1)
+        ):
+            # Classify only the matching post-edit caret from native
+            # delta/state metadata, not stale pre-lock Left/Right input.
+            # Delegate the complete GTK/default handler so native focus,
+            # cursor/context, selections and braille still update.
+            AXUtilitiesEvent.TEXT_EVENT_REASON[event] = pending[2]
+        return super()._on_caret_moved(event)
+
+    def _on_focused_changed(self, event):
+        self._password_caret = None
+        return super()._on_focused_changed(event)
