+@pytest.mark.unit
+def test_native_queue_keeps_edit_caret_then_right_then_left_distinct(test_context):
+    script, _, _, presenter, module, modules = setup_script(test_context)
+    from orca.event_manager import EventManager
+
+    manager = EventManager()
+    # Admission is outside this queue/presentation regression; retain the
+    # real enqueue, priority queue, latest-event index and obsolescence code.
+    test_context.patch_object(manager, "_ignore", return_value=False)
+    manager._gidle_id = 1
+    modules["orca.script_manager"].get_manager.return_value.get_script.return_value = script
+    delta = Delta(offset=3)
+    focus = modules["orca.focus_manager"].get_manager.return_value
+    focus.get_locus_of_focus.return_value = delta.source
+    events = [delta, caret_event(delta, 4), caret_event(delta, 5), caret_event(delta, 4)]
+    for event in events:
+        manager._enqueue_object_event(event)
+    reasons = []
+    while not manager._event_queue.empty():
+        _priority, counter, event = manager._event_queue.get_nowait()
+        assert manager._is_obsoleted_by(event) is None
+        if event.type.startswith("object:text-changed"):
+            script._on_text_inserted(event)
+        else:
+            script._on_caret_moved(event)
+            reasons.append(module.AXUtilitiesEvent.get_text_event_reason(event))
+    assert reasons == [
+        module.TextEventReason.TYPING,
+        module.TextEventReason.NAVIGATION_BY_CHARACTER,
+        module.TextEventReason.NAVIGATION_BY_CHARACTER,
+    ]
+    presenter.speak_character.assert_called_once_with("●")
+    assert presenter.speak_character_at_offset.call_count == 2
+    assert script._update_braille_caret_position.call_count == 3
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize("interruption", ["different-position", "focus-change"])
+def test_independent_navigation_clears_previous_delta_cause(test_context, interruption):
+    script, _, _, presenter, module, modules = setup_script(test_context)
+    delta = Delta(offset=3)
+    focus = modules["orca.focus_manager"].get_manager.return_value
+    focus.get_locus_of_focus.return_value = delta.source
+    script._on_text_inserted(delta)
+    if interruption == "different-position":
+        script._on_caret_moved(caret_event(delta, 2))
+    else:
+        test_context.patch_object(module.gtk.Script, "_on_focused_changed", return_value=True)
+        change = Delta()
+        change.type = "object:state-changed:focused"
+        script._on_focused_changed(change)
+    event = caret_event(delta, 4)
