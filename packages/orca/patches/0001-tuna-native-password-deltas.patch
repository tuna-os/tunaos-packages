+# SPDX-License-Identifier: LGPL-2.1-or-later
+"""Native password behavior with real queue, GTK/default handlers and caches."""
+
+import importlib
+from unittest.mock import Mock, call
+
+import pytest
+
+
+class Accessible:
+    def __init__(self, caret):
+        self.caret = caret
+
+
+class Delta:
+    """Custom password speech must not inspect the native text payload."""
+
+    def __init__(self, kind="insert", offset=0, count=1, system=False, source=None):
+        target = offset + count if kind == "insert" else offset
+        self.source = source or Accessible(target)
+        self.type = f"object:text-changed:{kind}" + (":system" if system else "")
+        self.detail1 = offset
+        self.detail2 = count
+
+    @property
+    def any_data(self):
+        raise AssertionError("password payload must not be read")
+
+
+def caret_event(delta, offset):
+    event = Delta(source=delta.source)
+    event.type = "object:text-caret-moved"
+    event.detail1 = offset
+    return event
+
+
+def setup_script(test_context):
+    # Stub the desktop/output boundary, never the script hierarchy,
+    # EventManager, AXUtilitiesEvent classifier or its real cache backend.
+    external = [
+        'action_presenter',
+        'ax_event_synthesizer',
+        'braille',
+        'braille_generator',
+        'braille_presenter',
+        'bypass_mode_manager',
+        'caret_navigator',
+        'chat_presenter',
+        'clipboard',
+        'command_manager',
+        'debugging_tools_manager',
+        'document_presenter',
+        'extension_loader',
+        'flat_review_finder',
+        'flat_review_presenter',
+        'learn_mode_presenter',
+        'live_region_presenter',
+        'math_navigator',
+        'mouse_presenter',
+        'mouse_review',
+        'notification_presenter',
+        'object_navigator',
+        'orca',
+        'orca_gui_prefs',
+        'presentation_manager',
+        'profile_manager',
+        'say_all_presenter',
+        'screen_reader_manager',
+        'script_utilities',
+        'sleep_mode_manager',
+        'sound_generator',
+        'speech_generator',
+        'speech_manager',
+        'speech_presenter',
+        'spellcheck_presenter',
+        'structural_navigator',
+        'system_information_presenter',
+        'systemd',
+        'table_navigator',
+        'text_selection_manager',
+        'text_selection_presenter',
+        'typing_echo_presenter',
+        'where_am_i_presenter',
+        'ax_document',
+        'ax_selection',
+        'ax_text',
+        'ax_utilities',
+        'ax_utilities_collection',
+        'ax_utilities_component',
+        'ax_utilities_debugging',
+        'ax_utilities_object',
+        'ax_utilities_relation',
+        'ax_utilities_role',
+        'ax_utilities_state',
+        'ax_utilities_text',
+        'ax_value',
+        'generator',
+        'input_event_manager',
+    ]
+    modules = test_context.setup_shared_dependencies([f"orca.{name}" for name in external])
+    modules["orca.debug"].debugLevel = 999
+    modules["orca.debug"].LEVEL_INFO = 800
+    modules["orca.ax_object"].AXObject.check_hung.return_value = False
+    utilities = modules["orca.ax_utilities"].AXUtilities
+    utilities.is_password_text.return_value = True
+    utilities.is_editable.return_value = True
+    utilities.is_focused.return_value = True
+    utilities.has_selected_text.return_value = False
+    utilities.get_cached_selected_text.return_value = ("", 0, 0)
+    modules["orca.ax_utilities_role"].AXUtilitiesRole.is_terminal.return_value = False
+    modules["orca.ax_utilities_text"].AXUtilitiesText.get_last_caret_set.return_value = None
+    text = modules["orca.ax_text"].AXText
+    text.get_caret_offset.side_effect = lambda source: source.caret
+    text.get_character_at_offset.side_effect = lambda source, offset, **_kw: ("●", offset, offset + 1)
+    input_manager = modules["orca.input_event_manager"].get_manager.return_value
+    for name in (
+        "last_event_was_caret_selection", "last_event_was_line_navigation",
+        "last_event_was_word_navigation", "last_event_was_up_or_down",
+        "last_event_was_page_up_or_page_down", "last_event_was_forward_caret_selection",
+    ):
+        getattr(input_manager, name).return_value = False
+    input_manager.last_event_was_caret_navigation.return_value = True
+    input_manager.last_event_was_character_navigation.return_value = True
+    modules["orca.flat_review_presenter"].get_presenter.return_value.is_active.return_value = False
+    modules["orca.caret_navigator"].get_navigator.return_value.last_input_event_was_navigation_command.return_value = False
+    modules["orca.text_selection_manager"].get_manager.return_value.get_current_selection_command.return_value = None
+    echo = modules["orca.typing_echo_presenter"].get_presenter.return_value
+    echo.get_key_echo_enabled.return_value = True
+    module = importlib.import_module("orca.scripts.apps.tuna-shell-gtk.script")
+    # Avoid initializing unrelated GTK/desktop controllers. All callback
+    # implementations below, including inherited caret presentation, are real.
+    script = object.__new__(module.Script)
+    script._password_caret = None
+    script.event_cache = {}
+    # Orca 50 stores queued events in the native event_cache above.
+    script.utilities = Mock()
+    script.utilities.get_caret_context.side_effect = lambda source: (source, source.caret)
+    script.utilities.handle_text_selection_change.return_value = False
+    script.update_braille = Mock()
+    script._update_braille_caret_position = Mock()
+    focus = modules["orca.focus_manager"].get_manager.return_value
+    focus.get_active_mode_and_object_of_interest.side_effect = lambda: ("focus", focus.get_locus_of_focus())
+    focus.get_last_cursor_position.return_value = (None, -1)
+    utilities.get_text_event_reason.side_effect = module.AXUtilitiesEvent.get_text_event_reason
+    presenter = modules["orca.presentation_manager"].get_manager.return_value
+    return script, utilities, echo, presenter, module, modules
+
+
+@pytest.mark.unit
+def test_burst_and_same_offset_replacement_are_distinct_commits(test_context):
+    script, _, _, presenter, _, _ = setup_script(test_context)
+    source = Accessible(20)
+    for offset in range(20):
+        assert script._on_text_inserted(Delta(offset=offset, source=source))
+    assert script._on_text_deleted(Delta("delete", offset=19, source=source))
+    assert script._on_text_inserted(Delta(offset=19, source=source))
+    assert presenter.speak_character.call_args_list == [call("●")] * 21
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize("count", [1, 3, 32])
+def test_unicode_and_paste_use_committed_count_not_payload(test_context, count):
+    script, _, _, presenter, _, _ = setup_script(test_context)
+    assert script._on_text_inserted(Delta(offset=7, count=count))
+    assert presenter.speak_character.call_args_list == [call("●")] * count
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize("kind", ["insert", "delete"])
+@pytest.mark.parametrize("enabled,system", [(True, False), (False, False), (True, True)])
+def test_braille_refresh_is_independent_of_speech(test_context, kind, enabled, system):
+    script, _, echo, presenter, _, _ = setup_script(test_context)
+    echo.get_key_echo_enabled.return_value = enabled
+    event = Delta(kind, system=system)
+    handler = script._on_text_inserted if kind == "insert" else script._on_text_deleted
+    assert handler(event)
+    script.update_braille.assert_called_once_with(event.source)
+    if kind == "delete" or not enabled or system:
+        presenter.speak_character.assert_not_called()
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize("offset,count", [(-1, 1), (0, 0), (0, -1), (0, 65536), (65536, 1)])
+def test_invalid_metadata_cannot_allocate_or_speak(test_context, offset, count):
+    script, _, _, presenter, _, _ = setup_script(test_context)
+    assert script._on_text_inserted(Delta(offset=offset, count=count))
+    presenter.speak_character.assert_not_called()
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize("predicate", ["is_password_text", "is_editable", "is_focused"])
+@pytest.mark.parametrize("kind", ["insert", "delete"])
+def test_other_delta_events_delegate_to_gtk(test_context, predicate, kind):
+    script, utilities, _, presenter, module, _ = setup_script(test_context)
+    getattr(utilities, predicate).return_value = False
+    hook = "_on_text_inserted" if kind == "insert" else "_on_text_deleted"
+    delegate = test_context.patch_object(module.gtk.Script, hook, return_value=False)
+    event = Delta(kind)
+    assert getattr(script, hook)(event) is False
+    delegate.assert_called_once_with(event)
+    presenter.speak_character.assert_not_called()
+
+
+@pytest.mark.unit
+@pytest.mark.parametrize("kind", ["insert", "delete"])
+@pytest.mark.parametrize("system", [False, True])
+def test_causal_caret_uses_real_version_cache_and_native_default_handler(test_context, kind, system):
+    script, _, _, presenter, module, modules = setup_script(test_context)
+    delta = Delta(kind, offset=3, system=system)
+    focus = modules["orca.focus_manager"].get_manager.return_value
+    focus.get_locus_of_focus.return_value = delta.source
+    handler = script._on_text_inserted if kind == "insert" else script._on_text_deleted
+    assert handler(delta)
+    target = 4 if kind == "insert" else 3
+    event = caret_event(delta, target)
+    # Exercise the actual classifier/cache read before the app corrects the
+    # stale input classification. Never create a stand-in cache attribute.
+    assert module.AXUtilitiesEvent.get_text_event_reason(event) == module.TextEventReason.NAVIGATION_BY_CHARACTER
+    assert script._on_caret_moved(event)
+    expected = module.TextEventReason.SYSTEM_UPDATE if system else module.TextEventReason.TYPING
+    assert module.AXUtilitiesEvent.get_text_event_reason(event) == expected
+    presenter.speak_character_at_offset.assert_not_called()
+    script._update_braille_caret_position.assert_called_once_with(delta.source)
+    navigation = caret_event(delta, target)
+    assert script._on_caret_moved(navigation)
+    assert module.AXUtilitiesEvent.get_text_event_reason(navigation) == module.TextEventReason.NAVIGATION_BY_CHARACTER
+    presenter.speak_character_at_offset.assert_called_once()
+
