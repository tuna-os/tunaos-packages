#!/usr/bin/env bash
# useradd wrapper: handle existing home directory gracefully
#
# EL10 shadow-utils 4.15.0 exits with code 12 (E_HOMEDIR) when useradd
# -m encounters a pre-existing home directory (e.g. /var/home/<user>
# already present from a previous install on the same disk). This causes
# gnome-initial-setup to fail on reinstall/upgrade scenarios where /var
# is preserved.
#
# Upstream shadow-utils 4.14.0 added an access(F_OK) early-return in
# create_home() that should skip mkdir when the target already exists.
# However, the EL10 4.15.0 package still exhibits the E_HOMEDIR failure
# (empirically confirmed; the precise trigger is not yet isolated —
# possible TOCTOU race, SELinux interaction, or an EL10-specific patch
# side-effect). Until the EL10 package resolves this at source, this
# wrapper intercepts useradd -m: when the target home directory already
# exists, it strips -m/--create-home, adds -M, invokes the real useradd,
# then chowns and restorecons the existing directory.
#
# See: https://github.com/tuna-os/tunaos-packages/issues/17
#
# Expiry condition (issue #392): delete this wrapper once EL10
# shadow-utils' create_home() actually honors the access(F_OK)
# early-return described above (upstream master returns early / only
# warns under -m when the home dir exists, instead of exiting
# E_HOMEDIR). Re-check on each EL10 point release with:
#   useradd -m -d <existing-dir> <user>; echo $?
# Exit 0 on the target release means this wrapper can be removed.

set -euo pipefail

# Overridable so tests can point this at a stub instead of the real system
# binary; unset in production, where it's always the real path.
REAL_USERADD="${REAL_USERADD:-/usr/sbin/useradd.shadow-utils}"

has_flag() {
    local flag="$1"; shift
    for a in "$@"; do
        [ "$a" = "$flag" ] && return 0
    done
    return 1
}

find_username() {
    for a in "$@"; do
        case "$a" in
            -*) continue ;;
            *) echo "$a"; return 0 ;;
        esac
    done
    return 1
}

find_home() {
    local home=""
    local i=0
    local args=("$@")
    while [ $i -lt ${#args[@]} ]; do
        case "${args[$i]}" in
            --home-dir=*) home="${args[$i]#*=}" ;;
            -d|--home|--home-dir)
                i=$((i + 1))
                [ $i -lt ${#args[@]} ] && home="${args[$i]}"
                ;;
        esac
        i=$((i + 1))
    done
    if [ -z "$home" ]; then
        local u; u=$(find_username "$@") || true
        [ -n "$u" ] && home="/var/home/$u"
    fi
    echo "$home"
}

if has_flag "-m" "$@" || has_flag "--create-home" "$@"; then
    HOME_DIR=$(find_home "$@")
    if [ -n "$HOME_DIR" ] && [ -d "$HOME_DIR" ]; then
        USERNAME=$(find_username "$@")
        # Strip -m/--create-home, add -M to skip home creation
        FILTERED=()
        add_M=true
        for arg in "$@"; do
            case "$arg" in
                -m|--create-home) ;;
                -M|--no-create-home) add_M=false ; FILTERED+=("$arg") ;;
                *) FILTERED+=("$arg") ;;
            esac
        done
        $add_M && FILTERED+=("-M")
        # Run real useradd, then fix ownership if it succeeded
        if "$REAL_USERADD" "${FILTERED[@]}"; then
            if [ -n "$USERNAME" ] && [ -d "$HOME_DIR" ]; then
                chown -R "$USERNAME:$USERNAME" "$HOME_DIR" 2>/dev/null || true
            fi
            restorecon -RF "$HOME_DIR" 2>/dev/null || true
        fi
        exit $?
    fi
fi

exec "$REAL_USERADD" "$@"
