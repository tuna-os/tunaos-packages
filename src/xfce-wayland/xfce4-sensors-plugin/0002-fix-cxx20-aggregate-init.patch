From: TunaOS packagers <packages@tunaos.org>
Subject: [PATCH] xfce4++: give the bool wrapper structs a constructor

Upstream: https://gitlab.xfce.org/panel-plugins/xfce4-sensors-plugin
Upstream-Status: Pending (not submitted yet; 1.5.0 still declares only a
 deleted default constructor)
Reason: PluginSize, Propagation, TimeoutResponse and TooltipTime are
 brace-initialised from a bool. With a deleted default constructor they
 stop being aggregates under C++20 (P1008R1), so the build fails with the
 newer default -std of Fedora ELN's gcc. A constexpr explicit bool
 constructor keeps the same brace-init valid on every standard.

--- a/xfce4++/util/gtk.h
+++ b/xfce4++/util/gtk.h
@@ -63,21 +63,25 @@
 
 struct PluginSize {
     bool rectangle; /* Whether the panel plugin size is forced to be a square. Otherwise, the plugin can be a rectangle. */
+    constexpr explicit PluginSize(bool rectangle) : rectangle(rectangle) {}
     PluginSize() = delete;
 };
 
 struct Propagation {
     bool stop; /* Whether to prevent the event from propagating to other handlers */
+    constexpr explicit Propagation(bool stop) : stop(stop) {}
     Propagation() = delete;
 };
 
 struct TimeoutResponse {
     bool again; /* Invoke the timeout handler again, otherwise stop the timer */
+    constexpr explicit TimeoutResponse(bool again) : again(again) {}
     TimeoutResponse() = delete;
 };
 
 struct TooltipTime {
     bool now; /* Whether to show the tooltip now or later */
+    constexpr explicit TooltipTime(bool now) : now(now) {}
     TooltipTime() = delete;
 };
 
